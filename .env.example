# Fülle alle erforderlichen Variablen aus, bevor du den Generator startest.
# API Keys
GEMINI_API_KEY=dein_gemini_key_hier
GOOGLE_APPLICATION_CREDENTIALS=gcloud-service-account.json
FREESOUND_API_KEY=dein_freesound_key_hier

# Podcast Einstellungen
PODCAST_NAME="Mein Podcast"
PODCAST_SLOGAN="Kurz, klar, spannend."
SCRIPT_DEFAULT_MODEL=gemini-3.1-pro-preview

# Pfade (relative oder absolute Pfade möglich)
PODCAST_TEMP_DIR=temp_assets
PODCAST_OUTPUT_DIR=finished_episodes
PODCAST_ASSETS_DIR=assets
